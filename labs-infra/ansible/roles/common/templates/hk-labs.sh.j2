# Managed by Ansible — Hacking Kubernetes study labs.
#
# Lab 0 builds `k` and `new_lab` interactively because a real workstation has
# many kubeconfig contexts. This VM has exactly one, so LAB_CONTEXT is fixed
# here and the selection menu is skipped. The function bodies are otherwise
# the ones printed in Lab 0.

export HK_STORE={{ hk_store }}
export HK_LAB_ROOT={{ hk_lab_root }}
export KUBECONFIG=/home/{{ hk_user }}/.kube/config
export LAB_CONTEXT=default

k() {
  if [ -z "${LAB_CONTEXT:-}" ]; then
    printf '%s\n' 'LAB_CONTEXT is empty; repeat Lab 0.' >&2
    return 1
  fi
  kubectl --context="$LAB_CONTEXT" "$@"
}

new_lab() {
  local namespace="$1"
  # Lab 0 prints this as a plain `create`, which is right on a bare cluster.
  # Here `hk deploy` has already created the namespace with exactly these
  # labels, so a plain create would fail on the FIRST step of every lab and
  # stop the run before it began. Create only when missing, then reassert the
  # labels — the end state is identical to Lab 0's, and repeating a step is
  # no longer an error.
  if ! k get namespace "$namespace" >/dev/null 2>&1; then
    k create namespace "$namespace" || return 1
  fi
  k label namespace "$namespace" \
    pod-security.kubernetes.io/enforce=restricted \
    pod-security.kubernetes.io/enforce-version={{ hk_psa_version }} \
    --overwrite || return 1
}

# `lab 4` jumps to Lab 4's working directory.
lab() {
  local n="${1:-}"
  [ -n "$n" ] || { hk-lab list; return 0; }
  local name
  name="$(printf 'lab%02d' "$((10#${n#[Ll]ab}))")" || return 1
  if [ -d "$HK_LAB_ROOT/$name" ]; then
    cd "$HK_LAB_ROOT/$name" && ls
  else
    printf '%s is not deployed. From the host: hk deploy %s\n' "$name" "$name" >&2
    return 1
  fi
}

# Every lab ships its commands as stepNN.sh, and those run in a CHILD bash.
# A shell function is not inherited by a child process unless it is exported,
# so without this `bash step02.sh` fails with "k: command not found" — the
# lab's own scripts would be unrunnable while the same commands typed by hand
# worked fine. Exported functions reach bash children only, which is what the
# step scripts are (`#!/usr/bin/env bash`).
export -f k new_lab lab

command -v kubectl >/dev/null && source <(kubectl completion bash) 2>/dev/null
complete -o default -F __start_kubectl k 2>/dev/null
