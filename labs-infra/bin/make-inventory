#!/usr/bin/env python3
"""Generate an Ansible inventory for the lab VM from `vagrant ssh-config`.

This is the seam between the two tools: Vagrant owns the machine and knows its
SSH details; Ansible reads them from here. Regenerated on every run, so a
rebuilt VM with a new port or host key just works.

Everything Vagrant reports is carried through. The options that matter most
are StrictHostKeyChecking=no and UserKnownHostsFile=/dev/null: a rebuilt VM
reuses 127.0.0.1 with a fresh host key, so without them SSH refuses to connect.
"""
import os
import re
import subprocess
import sys

# realpath, not abspath: this resolves symlinks, so the script still finds
# labs.yml when bin/ is linked onto PATH.
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

# ssh-config keys that become native Ansible variables rather than -o options.
NATIVE = {
    "hostname": "ansible_host",
    "user": "ansible_user",
    "port": "ansible_port",
    "identityfile": "ansible_ssh_private_key_file",
}
# Noise that must not become an -o option.
SKIP = {"host"}


def vm_name():
    spec = open(os.path.join(ROOT, "labs.yml"), encoding="utf-8").read()
    m = re.search(r'^vm:\s*$.*?^  name:\s*(\S+)', spec, re.M | re.S)
    if not m:
        sys.exit("make-inventory: no vm.name in labs.yml")
    return m.group(1)


def main():
    name = vm_name()

    state = subprocess.run(["vagrant", "status", name], cwd=ROOT,
                           capture_output=True, text=True).stdout
    if not re.search(r"\brunning\b", state):
        sys.exit("make-inventory: the VM is not running. Create it with 'hk build'.")

    proc = subprocess.run(["vagrant", "ssh-config", name], cwd=ROOT,
                          capture_output=True, text=True)
    if proc.returncode != 0:
        sys.exit(f"make-inventory: vagrant ssh-config failed:\n{proc.stderr.strip()}")

    native, opts = {}, []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, _, value = line.partition(" ")
        value = value.strip().strip('"')
        low = key.lower()
        if low in SKIP or not value:
            continue
        if low in NATIVE:
            native[NATIVE[low]] = value
        else:
            opts.append(f"-o {key}={value}")

    missing = [v for v in NATIVE.values() if v not in native]
    if missing:
        sys.exit(f"make-inventory: vagrant ssh-config did not report {', '.join(missing)}")

    vars_ = " ".join(f"{k}={v}" for k, v in sorted(native.items()))
    common = " ".join(opts)

    out = os.path.join(ROOT, "ansible", "inventory", "hosts.ini")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(
            "# Generated by bin/make-inventory from 'vagrant ssh-config "
            f"{name}'.\n# Do not edit; it is overwritten on every run.\n"
            "[labvm]\n"
            f"{name} {vars_} ansible_ssh_common_args='{common}'\n"
        )
    print(out)


if __name__ == "__main__":
    main()
