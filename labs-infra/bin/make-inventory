#!/usr/bin/env python3
"""Generate an Ansible inventory for the lab VMs from `vagrant ssh-config`.

This is the seam between the two tools: Vagrant owns the machines and knows
their SSH details; Ansible reads them from here. Regenerated on every run, so a
rebuilt box with a new port or host key just works.

Two machines are described, in two groups:

    [labvm]     hk-labs   the lab machine: k3s, gVisor, Falco, Docker
    [mgmtvm]    hk-mgmt   the management machine: RKE2 and Rancher

Whichever machines are running are written out. The command line names the
groups this particular run cannot proceed without:

    make-inventory labvm            the lab VM must be up
    make-inventory mgmtvm           the management VM must be up
    make-inventory labvm mgmtvm     both, as the Rancher import needs

Everything Vagrant reports is carried through. The options that matter most
are StrictHostKeyChecking=no and UserKnownHostsFile=/dev/null: a rebuilt VM
reuses 127.0.0.1 with a fresh host key, so without them SSH refuses to connect.
"""
import os
import re
import subprocess
import sys

# realpath, not abspath: this resolves symlinks, so the script still finds
# labs.yml when bin/ is linked onto PATH.
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

# ssh-config keys that become native Ansible variables rather than -o options.
NATIVE = {
    "hostname": "ansible_host",
    "user": "ansible_user",
    "port": "ansible_port",
    "identityfile": "ansible_ssh_private_key_file",
}
# Noise that must not become an -o option.
SKIP = {"host"}

# Ansible group -> the labs.yml key describing that machine.
GROUPS = {"labvm": "vm", "mgmtvm": "mgmt"}


def machine_name(key):
    """The VM name under a top-level labs.yml key, read without a YAML parser.

    The Vagrantfile parses this file with Ruby's YAML and bin/hk with awk;
    keeping this script dependency-free means the inventory can be rebuilt on a
    machine that has nothing but Python installed.
    """
    spec = open(os.path.join(ROOT, "labs.yml"), encoding="utf-8").read()
    m = re.search(r'^%s:\s*$.*?^  name:\s*(\S+)' % re.escape(key), spec, re.M | re.S)
    if not m:
        sys.exit(f"make-inventory: no {key}.name in labs.yml")
    return m.group(1)


def running(name):
    state = subprocess.run(["vagrant", "status", name], cwd=ROOT,
                           capture_output=True, text=True).stdout
    return bool(re.search(r"\brunning\b", state))


def ssh_config(name):
    """Return (native vars, -o options) for one machine, or exit trying."""
    proc = subprocess.run(["vagrant", "ssh-config", name], cwd=ROOT,
                          capture_output=True, text=True)
    if proc.returncode != 0:
        sys.exit(f"make-inventory: vagrant ssh-config {name} failed:\n"
                 f"{proc.stderr.strip()}")

    native, opts = {}, []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, _, value = line.partition(" ")
        value = value.strip().strip('"')
        low = key.lower()
        if low in SKIP or not value:
            continue
        if low in NATIVE:
            native[NATIVE[low]] = value
        else:
            opts.append(f"-o {key}={value}")

    missing = [v for v in NATIVE.values() if v not in native]
    if missing:
        sys.exit(f"make-inventory: vagrant ssh-config {name} did not report "
                 f"{', '.join(missing)}")
    return native, opts


def main():
    required = sys.argv[1:] or ["labvm"]
    unknown = [g for g in required if g not in GROUPS]
    if unknown:
        sys.exit(f"make-inventory: unknown group(s) {', '.join(unknown)}; "
                 f"expected any of {', '.join(GROUPS)}")

    lines = ["# Generated by bin/make-inventory from 'vagrant ssh-config'.",
             "# Do not edit; it is overwritten on every run."]

    for group, key in GROUPS.items():
        name = machine_name(key)
        lines.append(f"[{group}]")
        if not running(name):
            if group in required:
                how = "bin/hk build" if group == "labvm" else "bin/hk mgmt build"
                sys.exit(f"make-inventory: the {name} VM is not running. "
                         f"Create it with '{how}'.")
            # Left as an empty group on purpose: a playbook that targets it
            # reports "no hosts matched" rather than failing to parse.
            lines.append("")
            continue
        native, opts = ssh_config(name)
        vars_ = " ".join(f"{k}={v}" for k, v in sorted(native.items()))
        lines.append(f"{name} {vars_} ansible_ssh_common_args='{' '.join(opts)}'")
        lines.append("")

    out = os.path.join(ROOT, "ansible", "inventory", "hosts.ini")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines).rstrip() + "\n")
    print(out)


if __name__ == "__main__":
    main()
