#!/usr/bin/env python3
"""Give this Mac browser access to Rancher: hostname resolution and CA trust.

Run through `hk rancher --setup`. Never called by a build, a lab action or any
Ansible run — changing a laptop's hosts file and system trust store is not
something provisioning should do behind your back.

Adapted from the browser-setup helper in anasgrt/chaos-theory-labs.

Two things need doing and both need sudo, so this asks for it only where it is
actually needed rather than running the whole script as root:

  1. /etc/hosts        so the browser can resolve the Rancher hostname
  2. the system keychain   so it accepts the lab CA's certificate

The path to the VM and its certificate are verified BEFORE anything on this
machine is changed, so a broken Rancher cannot leave the laptop half-configured.
"""
import base64
import hashlib
import ipaddress
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HOSTS = Path('/etc/hosts')
SYSTEM_KEYCHAIN = '/Library/Keychains/System.keychain'
CA_FILE = ROOT / 'hk-rancher-ca.crt'


def field(top, key):
    """One `key:` under a top-level `top:` in labs.yml, without a YAML parser.

    labs.yml is the single source of truth the Vagrantfile, Ansible and bin/hk
    all read; keeping this dependency-free means browser setup works on a Mac
    with nothing but the system Python.
    """
    text = (ROOT / 'labs.yml').read_text(encoding='utf-8')
    m = re.search(r'^%s:\s*$(.*?)(?=^\S)' % re.escape(top), text, re.M | re.S)
    if m:
        k = re.search(r'^  %s:\s*(\S+)' % re.escape(key), m.group(1), re.M)
        if k:
            return k.group(1)
    sys.exit(f'hk-browser-setup: no {top}.{key} in labs.yml')


def validate(ip, hostname):
    if ipaddress.ip_address(ip).version != 4:
        raise ValueError('The management address must be IPv4.')
    if not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+',
                        hostname):
        raise ValueError(f'Invalid Rancher hostname: {hostname}')


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


# --- /etc/hosts ------------------------------------------------------------

def update_hosts(content, ip, hostname):
    """Replace only this hostname, keeping other aliases and comments intact."""
    validate(ip, hostname)
    result = []
    for line in content.splitlines(keepends=True):
        entry, marker, comment = line.partition('#')
        fields = entry.split()
        if len(fields) < 2 or hostname.lower() not in [v.lower() for v in fields[1:]]:
            result.append(line)
            continue
        aliases = [v for v in fields[1:] if v.lower() != hostname.lower()]
        if aliases:
            result.append(fields[0] + '\t' + ' '.join(aliases)
                          + (' #' + comment.rstrip('\n') if marker else '') + '\n')
        elif marker:
            result.append('#' + comment.rstrip('\n') + '\n')
    text = ''.join(result)
    return text + ('' if not text or text.endswith('\n') else '\n') + f'{ip} {hostname}\n'


def install_hosts(ip, hostname):
    if os.geteuid() != 0:
        raise RuntimeError('Updating /etc/hosts requires sudo.')
    original = HOSTS.read_text()
    updated = update_hosts(original, ip, hostname)
    if original == updated:
        return
    # A unique backup per actual change. Written through the original file so
    # its mode and ownership survive, rather than replaced by a temp file.
    with tempfile.NamedTemporaryFile(prefix='hosts.hk-backup.', dir='/etc',
                                     mode='w', delete=False) as backup:
        backup.write(original)
        print(f'  hosts backup: {backup.name}', flush=True)
    HOSTS.write_text(updated)


# --- the lab CA ------------------------------------------------------------

def pem_certificates(bundle):
    return re.findall(r'-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----', bundle, re.S)


def certificate_digests(pem):
    """The SHA-1 and SHA-256 digests macOS identifies a certificate by."""
    body = ''.join(line for line in pem.splitlines() if 'CERTIFICATE' not in line)
    der = base64.b64decode(body)
    return hashlib.sha1(der).hexdigest().upper(), hashlib.sha256(der).hexdigest().upper()


def superseded_certificates(bundle, current_pem):
    """SHA-1 digests of same-named lab CAs that are not the current one.

    Rebuilding hk-mgmt mints a new CA under the same name. macOS only ever ADDS
    trust, so every rebuild leaves another trusted root behind, and a browser
    validating today's certificate against a dead root fails in a way that is
    hard to read. Identity is taken from the digest, never from the name.
    """
    current = certificate_digests(current_pem)[1]
    stale = []
    for block in pem_certificates(bundle):
        sha1, sha256 = certificate_digests(block)
        if sha256 != current and sha1 not in stale:
            stale.append(sha1)
    return stale


def common_name(pem_path):
    subject = run('/usr/bin/openssl', 'x509', '-in', str(pem_path), '-noout',
                  '-subject', '-nameopt', 'RFC2253',
                  capture_output=True, text=True).stdout
    m = re.search(r'CN=([^,\n]+)', subject)
    if not m:
        raise RuntimeError('The exported lab CA has no common name.')
    return m.group(1).strip()


def prune_superseded_cas(ca_path, keychain=SYSTEM_KEYCHAIN):
    """Remove the lab CAs this one replaced, reporting each removal.

    Deliberately narrow: only certificates sharing this CA's own common name,
    and only those whose digest differs from the CA now in use. The current CA,
    and any certificate with another subject, are never touched.
    """
    current_pem = Path(ca_path).read_text()
    name = common_name(ca_path)
    listing = subprocess.run(['/usr/bin/security', 'find-certificate', '-c', name, '-a', '-p', keychain],
                             capture_output=True, text=True)
    stale = superseded_certificates(listing.stdout, current_pem)
    if not stale:
        return []
    print(f'  removing {len(stale)} superseded "{name}" certificate(s) from an earlier VM', flush=True)
    for sha1 in stale:
        run('sudo', '/usr/bin/security', 'delete-certificate', '-Z', sha1, keychain)
        print(f'  removed stale lab CA {sha1}', flush=True)
    return stale


# --- main ------------------------------------------------------------------

def export_ca():
    """Only the public certificate; the CA key never leaves hk-mgmt."""
    pem = run(str(ROOT / 'bin/hk'), 'rancher', '--ca',
              capture_output=True, text=True).stdout
    if 'BEGIN CERTIFICATE' not in pem:
        raise RuntimeError('Could not read the lab CA. Is the management VM running? '
                           'Build it with: hk mgmt build')
    CA_FILE.write_text(pem)
    return str(CA_FILE)


def main():
    if sys.platform != 'darwin':
        raise RuntimeError('hk rancher --setup currently supports macOS. On Linux, add the '
                           'hosts entry and import hk-rancher-ca.crt through your '
                           "distribution's or browser's certificate manager.")
    if len(sys.argv) == 4 and sys.argv[1] == '--hosts-only':
        install_hosts(sys.argv[2], sys.argv[3])
        return
    if len(sys.argv) != 1 or os.geteuid() == 0:
        raise RuntimeError('Run `hk rancher --setup` as your normal user; '
                           'it asks for sudo only where it needs it.')

    ip = field('mgmt', 'ip')
    hostname = field('rancher', 'hostname')
    validate(ip, hostname)

    print(f'Rancher at https://{hostname} ({ip})')
    ca = export_ca()

    # Verify the path to the VM and its certificate BEFORE touching this Mac,
    # supplying the address and the CA by hand. A Rancher that is not serving
    # must not leave the laptop half-configured.
    reply = run('/usr/bin/curl', '--fail', '--silent', '--show-error', '--noproxy', '*',
                '--connect-timeout', '5', '--max-time', '15', '--cacert', ca,
                '--resolve', f'{hostname}:443:{ip}', f'https://{hostname}/ping',
                capture_output=True, text=True).stdout
    if reply != 'pong':
        raise RuntimeError('Rancher did not answer /ping with pong; nothing was changed. '
                           'Check it with: hk mgmt check')
    print('  reachable, and its certificate verifies against the lab CA')

    original = HOSTS.read_text()
    if update_hosts(original, ip, hostname) != original:
        print(f'Adding {ip} {hostname} to /etc/hosts. Enter your Mac password if prompted.', flush=True)
        run('sudo', sys.executable, str(Path(__file__).resolve()), '--hosts-only', ip, hostname)
        run('sudo', '/usr/bin/dscacheutil', '-flushcache')
        run('sudo', '/usr/bin/killall', '-HUP', 'mDNSResponder')
    else:
        print('  /etc/hosts already correct')

    trusted = subprocess.run(['/usr/bin/security', 'verify-cert', '-c', ca, '-p', 'ssl'],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if trusted.returncode:
        print('Trusting the lab CA for SSL. Approve the macOS prompt.', flush=True)
        run('sudo', '/usr/bin/security', 'add-trusted-cert', '-d', '-r', 'trustRoot',
            '-p', 'ssl', '-k', SYSTEM_KEYCHAIN, ca)
    else:
        print('  lab CA already trusted')

    prune_superseded_cas(ca)

    # The real test: this Mac's own resolver and trust store, no overrides.
    final = run('/usr/bin/curl', '--fail', '--silent', '--show-error', '--noproxy', '*',
                '--connect-timeout', '5', '--max-time', '15',
                f'https://{hostname}/ping', capture_output=True, text=True).stdout
    if final != 'pong':
        raise RuntimeError('The hostname and CA are installed but the check still failed.')

    print(f'\nDone. Open https://{hostname} and sign in as admin.')
    print("The password is printed by: hk rancher")
    print('If a browser is already open on an error, quit it fully — both Chrome and')
    print('Opera cache DNS and certificate failures for the session.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f'Browser setup failed: {error}\n'
                 'Run `hk rancher --setup` in an interactive Terminal. It is safe to retry.')
